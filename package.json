{
  "name": "mastery-roadmap",
  "version": "1.0.0",
  "description": "LLM-Powered Personal Learning Engine",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "HOST=127.0.0.1 PORT=3200 node server/index.js",
    "dev:client": "PORT=3201 npx vite --config client/vite.config.js client --host 127.0.0.1",
    "build": "cd client && npx vite build --config ./vite.config.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npx vitest run --config ./server/vitest.config.js server",
    "test:frontend": "cd client && npx vitest run --config ./vitest.config.js",
    "lint": "echo 'No lint configured'",
    "typecheck": "echo 'No typecheck configured'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@earendil-works/pi-ai": "0.85.1",
    "ai": "^4.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "jsdom": "^26.0.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
