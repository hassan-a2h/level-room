{
  "name": "mastery-roadmap",
  "version": "1.0.0",
  "description": "LLM-Powered Personal Learning Engine",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "HOST=127.0.0.1 PORT=3200 node server/index.js",
    "dev:client": "PORT=3201 npx vite --config client/vite.config.js client --host 127.0.0.1",
    "dev:client:e2e": "npx vite --config client/vite.config.js client --host 127.0.0.1 --port 3202 --strictPort",
    "build": "cd client && npx vite build --config ./vite.config.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npx vitest run --config ./server/vitest.config.js server",
    "test:frontend": "cd client && npx vitest run --config ./vitest.config.js",
    "lint": "eslint .",
    "test:visual": "playwright test --config client/playwright.config.js client/e2e/visual",
    "test:a11y": "playwright test --config client/playwright.config.js client/e2e/accessibility.spec.js",
    "test:state-preservation": "playwright test --config client/playwright.config.js client/e2e/state-preservation.spec.js",
    "assets:optimize": "node scripts/optimize-theme-assets.mjs",
    "assets:check": "node --test scripts/optimize-theme-assets.test.mjs && node scripts/optimize-theme-assets.mjs --check",
    "perf:check": "npm run build && node --test scripts/check-ui-budgets.test.mjs && node scripts/check-ui-budgets.mjs",
    "verify:ui": "npm run lint && npm run test:frontend && npm run test:backend && npm run build && npm run assets:check && npm run perf:check && npm run test:visual && npm run test:state-preservation && npm run test:a11y",
    "typecheck": "echo 'No typecheck configured'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@earendil-works/pi-ai": "0.85.1",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "ai": "^4.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "lucide-react": "^1.48.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.5",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
